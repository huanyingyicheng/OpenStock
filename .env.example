## Minimal config to run OpenStock locally (production-style).
## Copy to `.env` and fill values.
##
## NOTE:
## - Local `next start` serves plain HTTP (no TLS). Open: http://localhost:3000
## - If your browser has “HTTPS-Only / Always use secure connections” enabled,
##   it may auto-upgrade to https:// and then fail. Disable it for localhost.

# Core
NODE_ENV=production
PORT=3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/openstock

# Better Auth
BETTER_AUTH_SECRET=replace_me_with_a_long_random_string
# Must match the scheme/host you actually open in the browser (local = http).
BETTER_AUTH_URL=http://localhost:3000

# Debug
# Visit http://localhost:3000/api/health to check env + MongoDB connectivity.

# Finnhub (market data)
NEXT_PUBLIC_FINNHUB_API_KEY=replace_me
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Inngest AI (optional)
GEMINI_API_KEY=
INNGEST_SIGNING_KEY=

# Email (optional; used for welcome/news emails)
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
